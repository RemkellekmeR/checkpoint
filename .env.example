# Copy to .env and fill in locally. .env is gitignored; never commit real values.

# Clocked API key from https://clocked.rezolve.ai/account (Create API key).
# When unset, Checkpoint refuses to start unless the offline stubs below are selected explicitly.
CLOCKED_API_KEY=

# Offline stubs for local tests only (NOT Clocked, NOT real screening). Used only when CLOCKED_API_KEY is unset.
# CHECKPOINT_GUARD=offline-stub
# CHECKPOINT_PROTECT=offline-stub
# CHECKPOINT_INSPECT=offline-stub

# Optional: override the Clocked base URL (SDK default https://clocked.rezolve.ai/clocked).
CLOCKED_BASE_URL=

# MCP server bind address and port (bind loopback locally).
CHECKPOINT_HOST=127.0.0.1
CHECKPOINT_PORT=3333

# Comma-separated Origin hostnames allowed to call /mcp (requests with any other Origin get 403).
CHECKPOINT_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
