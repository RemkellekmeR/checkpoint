#!/usr/bin/env sh
# Checkpoint pre-commit hook: block commits that contain secrets.
# Enable once per clone:  git config core.hooksPath .githooks
# Requires gitleaks >= 8.19 (uses `gitleaks git --staged`). Install: https://github.com/gitleaks/gitleaks#installing
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; refusing to commit without a secret scan." >&2
  echo "Install it (https://github.com/gitleaks/gitleaks#installing) or see README > Secret scanning." >&2
  exit 1
fi

# Scan only what is staged for this commit.
exec gitleaks git --staged --redact --no-banner --verbose .
