{
  "name": "checkpoint",
  "version": "0.1.0",
  "description": "An MCP firewall for IT service-desk agents: every tool call passes through Clocked Guard, Protect and Inspect.",
  "license": "MIT",
  "author": "Jamey Thomas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "smoke": "node --import tsx scripts/smoke.ts",
    "check": "npm run typecheck && npm test && npm run smoke",
    "record:clocked": "node scripts/record-clocked.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "clocked-sdk": "0.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
